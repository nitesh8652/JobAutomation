# ---------------------------------------------------------------------------
# Database (production: MySQL; SQLite is used automatically if this is omitted)
# ---------------------------------------------------------------------------
JOBBOT_DATABASE_URL=mysql+pymysql://jobbot:change-me@127.0.0.1:3306/jobbot?charset=utf8mb4
# DATABASE_URL=mysql+pymysql://jobbot:change-me@127.0.0.1:3306/jobbot?charset=utf8mb4

# ---------------------------------------------------------------------------
# Local API / dashboard
# ---------------------------------------------------------------------------
JOBBOT_HOST=127.0.0.1
JOBBOT_PORT=8766
# Optional bearer token. If set, the dashboard must save it in Settings and API
# clients must send X-API-Token or Authorization: Bearer <token>.
JOBBOT_API_TOKEN=
# Comma-separated extra CORS origins (localhost origins are allowed by default)
JOBBOT_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# AI: local Ollama first, optional OpenAI-compatible cloud fallback
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Discovery APIs already used by the legacy project
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_KEY=

# ---------------------------------------------------------------------------
# Browser
# ---------------------------------------------------------------------------
# Visible Chrome is required. Set only if Google Chrome is not installed.
JOBBOT_BROWSER_CHANNEL=
# Dedicated profile directory (never your normal Chrome profile)
JOBBOT_BROWSER_PROFILE=data/chrome-jobbot-profile
